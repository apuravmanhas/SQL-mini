# VerityTick — Environment Configuration
# Copy to .env and fill in your values. NEVER commit .env to Git.

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here
PGDATABASE=veritytick

# VerityTick application database
VT_DB_NAME=veritytick
VT_DB_HOST=localhost
VT_DB_PORT=5432
VT_DB_USER=postgres
VT_DB_PASSWORD=your_password_here

# Test database (separate from dev)
VT_TEST_DB_NAME=veritytick_test

# Gemini API Key (optional — for AI surveillance & regulatory brief generation)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
